## Part 4: Automated Audit Utility

### JavaScript Accessibility Scanner

Embed this to detect common ARIA violations during development.

```javascript
/**
 * Accessibility Audit Utility
 * Run in browser console to detect common violations
 */
class AccessibilityAuditor {
  constructor() {
    this.violations = [];
  }

  runAudit() {
    this.checkAriaAttributes();
    this.checkAccessibleNames();
    this.checkButtonRoles();
    this.checkTreeWidgets();
    return this.violations;
  }

  checkAriaAttributes() {
    const elements = document.querySelectorAll('[aria-*]');
    elements.forEach(el => {
      const role = el.getAttribute('role');
      const ariaAttrs = Array.from(el.attributes)
        .filter(a => a.name.startsWith('aria-'));
      
      ariaAttrs.forEach(attr => {
        // Check if attribute is valid for this role
        if (!this.isValidAriaForRole(attr.name, role)) {
          this.violations.push({
            type: 'invalid-aria',
            element: el.tagName,
            attribute: attr.name,
            suggestion: `Remove ${attr.name} from ${role || 'implicit'} role`
          });
        }
      });
    });
  }

  checkAccessibleNames() {
    const interactive = document.querySelectorAll(
      'button, [role="button"], a[href]'
    );
    
    interactive.forEach(el => {
      const name = this.getAccessibleName(el);
      if (!name || name.trim() === '') {
        this.violations.push({
          type: 'missing-name',
          element: el.tagName,
          suggestion: 'Add aria-label or visible text content'
        });
      }
    });
  }

  checkButtonRoles() {
    const buttons = document.querySelectorAll(
      '[role="button"], button'
    );
    
    buttons.forEach(btn => {
      if (btn.hasAttribute('aria-activedescendant')) {
        this.violations.push({
          type: 'wrong-aria-on-button',
          element: btn.tagName,
          suggestion: 'Remove aria-activedescendant; use aria-expanded instead'
        });
      }
    });
  }

  checkTreeWidgets() {
    const trees = document.querySelectorAll('[role="tree"]');
    
    trees.forEach(tree => {
      if (tree.hasAttribute('aria-setsize')) {
        this.violations.push({
          type: 'aria-setsize-on-tree',
          element: 'role="tree"',
          suggestion: 'Move aria-setsize to role="treeitem" children'
        });
      }
    });
  }

  isValidAriaForRole(attribute, role) {
    // Simplified validation — use full ARIA spec for production
    const forbiddenOnButton = ['aria-activedescendant'];
    const forbiddenOnTree = ['aria-setsize'];
    
    if (role === 'button' && forbiddenOnButton.includes(attribute)) {
      return false;
    }
    if (role === 'tree' && forbiddenOnTree.includes(attribute)) {
      return false;
    }
    return true;
  }

  getAccessibleName(el) {
    return (
      el.getAttribute('aria-label') ||
      el.getAttribute('aria-labelledby') ||
      el.textContent?.trim() ||
      el.getAttribute('alt') ||
      null
    );
  }

  report() {
    console.table(this.violations);
    console.log(`Found ${this.violations.length} violations`);
    return this.violations;
  }
}

// Usage:
// const auditor = new AccessibilityAuditor();
// auditor.runAudit().report();
```

